
version: 1.0.0
environment: development  # development, testing, production
debug: false

# 浏览器配置
browser:
  login_method: password # 默认登录方式：password, qr_code, sms
  path:
    chrome_path: path_to/chrome.exe       # Chrome可执行文件路径，null则自动查找
    url: https://www.jd.com/?country=CN
  physical:
    window_width: 2560      # 浏览器窗口宽度
    window_height: 1660      # 浏览器窗口高度
  network:
    user_agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
    headless: false         # 是否无头模式运行
    disable_images: true    # 是否禁用图片加载以加速
    proxy: null             # 代理服务器，如 "http://127.0.0.1:8080"
    user_data_dir: cookie/JD     # 用户数据目录，用于保存cookies
  # 京东账户配置
  jd_account:
    username:                 # 京东用户名/手机号
    password:                 # 京东密码（将自动加密）
    login_method: "password"  # 登录方式：password, qr_code, sms
    max_login_attempts: 3     # 最大登录尝试次数
    login_timeout: 60         # 登录超时时间（秒）
    save_cookies: true        # 是否保存cookies
    cookies_expiry_days: 7    # cookies过期天数
  search:
    keyword: 笔记本电脑内存 DDR5 32G # 搜索关键词
  coord:
    search_box: [650, 250]   # 搜索框坐标
    plug_in: [2340, 95]      # 插件按钮坐标
    export: [575, 350]      # 导出按钮坐标
    plug_out: [1036, 268]   # 关闭插件按钮坐标
  
# 数据库配置
database:
  type: "sqlite"                        # 数据库类型：sqlite, mysql, postgresql
  path: products.db                     # SQLite数据库文件路径
  host: localhost                       # 数据库主机
  port: 5050                            # 数据库端口
  name: products                        # 数据库名称
  user: ""                              # 数据库用户名
  password: ""                          # 数据库密码（将自动加密）
  backup_days: 7                        # 备份保留天数
  auto_backup: true                     # 是否自动备份
  backup_dir: "backups"                 # 备份目录
  connection_pool_size: 5               # 数据库连接池大小

# 数据处理器配置
data_processing:
  csv_path: "C:/Users/34739/Downloads/data.csv"  # CSV文件路径
  default_category: "内存条"                      # 默认商品分类
  cleanup_old_files: true                         # 是否清理旧文件
  keep_latest_files: 3                           # 保留最新的文件数量
  auto_import: true                              # 是否自动导入CSV到数据库

# 人类行为模拟配置
human_simulator:
  enable_random_behavior: false         # 是否启用随机行为
  min_delay: 0.1          # 最小延迟（秒）
  max_delay: 0.5          # 最大延迟（秒）
  think_time_min: 0.2     # 最小思考时间（秒）
  think_time_max: 1.0     # 最大思考时间（秒）
  speed_min: 0.3          # 最小移动速度（秒）
  speed_max: 0.8          # 最大移动速度（秒）
  curve_factor: 0.3       # 鼠标曲线移动程度（0-1）
  jitter_factor: 0.05     # 鼠标抖动程度（0-1）
  error_probability: 0.01 # 输入错误概率（0-1）
  error_correction_probability: 1.0  # 纠错概率（0-1）
  wait_after_login: 5.0                 # 登录后等待时间（秒）

# 数据可视化配置
visualization:
  price_history_days: 30                         # 价格历史显示天数
  update_interval_hours: 24                      # 数据更新间隔(小时)
  chart_colors:                                  # 图表颜色配置
    - "#1f77b4"  # 蓝色
    - "#ff7f0e"  # 橙色
    - "#2ca02c"  # 绿色
    - "#d62728"  # 红色
    - "#9467bd"  # 紫色